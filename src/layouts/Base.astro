---
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  /** schema.org structured data, so search engines and AI tools can read the key facts. */
  jsonLd?: Record<string, unknown>;
}

const { title, description, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    {/* Hugging Face answers 404 to a click that carries this site's address as Referer. */}
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replaceAll('<', '\\u003c')}
      />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
