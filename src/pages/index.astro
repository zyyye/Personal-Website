---
// Home page: the five-slide deck (plan section 3). Phase 1 shell: placeholder slide bodies.
// Phase 2 adds content, Phase 3 the design, Phase 4 the hero.
import Base from '../layouts/Base.astro';
import Deck from '../components/Deck.astro';
import Taskbar from '../components/Taskbar.astro';
---

<Base
  title="Yeo Zhi Yuan: data science and AI portfolio"
  description="Portfolio of Yeo Zhi Yuan, NUS Data Science and Analytics student."
>
  <Deck>
    <section id="hero" class="slide" data-slide aria-labelledby="hero-title">
      <div class="window">
        <h1 id="hero-title">Yeo Zhi Yuan</h1>
        <p>Placeholder slide. The hero is built in Phase 4.</p>
      </div>
    </section>
    <section id="about" class="slide" data-slide aria-labelledby="about-title">
      <div class="window">
        <h2 id="about-title">About</h2>
        <p>Placeholder slide. Content arrives in Phase 2, design in Phase 3.</p>
      </div>
    </section>
    <section id="work" class="slide" data-slide aria-labelledby="work-title">
      <div class="window">
        <h2 id="work-title">Work</h2>
        <p>Placeholder slide. Content arrives in Phase 2, design in Phase 3.</p>
      </div>
    </section>
    <section id="learning" class="slide" data-slide aria-labelledby="learning-title">
      <div class="window">
        <h2 id="learning-title">Skills and learning</h2>
        <p>Placeholder slide. Content arrives in Phase 2, design in Phase 3.</p>
      </div>
    </section>
    <section id="contact" class="slide" data-slide aria-labelledby="contact-title">
      <div class="window">
        <h2 id="contact-title">Contact</h2>
        <p>Placeholder slide. Content arrives in Phase 2, design in Phase 3.</p>
      </div>
    </section>
  </Deck>
  <Taskbar />
</Base>
