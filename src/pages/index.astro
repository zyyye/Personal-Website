---
// Home page: the five-slide deck (plan section 3).
import AboutSlide from '../components/AboutSlide.astro';
import ContactSlide from '../components/ContactSlide.astro';
import Deck from '../components/Deck.astro';
import HeroSlide from '../components/HeroSlide.astro';
import LearningSlide from '../components/LearningSlide.astro';
import Taskbar from '../components/Taskbar.astro';
import WorkSlide from '../components/WorkSlide.astro';
import Base from '../layouts/Base.astro';
import { profile } from '../lib/data.ts';
---

<Base title={`${profile.name}: data science and AI portfolio`} description={profile.headline}>
  <Deck>
    <HeroSlide />
    <AboutSlide />
    <WorkSlide />
    <LearningSlide />
    <ContactSlide />
  </Deck>
  <Taskbar />
</Base>
