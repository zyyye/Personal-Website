---
// Home page: the deck, one page per project, internship and achievement (src/lib/pages.ts).
import AboutSlide from '../components/AboutSlide.astro';
import AchievementSlide from '../components/AchievementSlide.astro';
import ContactSlide from '../components/ContactSlide.astro';
import Deck from '../components/Deck.astro';
import HeroSlide from '../components/HeroSlide.astro';
import ProjectSlide from '../components/ProjectSlide.astro';
import Taskbar from '../components/Taskbar.astro';
import Base from '../layouts/Base.astro';
import { achievements, deck, education, profile, visibleProjects } from '../lib/data.ts';

const { pages, groups } = await deck();
const projectById = new Map((await visibleProjects()).map((p) => [p.id, p]));
const achievementById = new Map((await achievements()).map((a) => [a.id, a]));

function must<T>(map: Map<string, T>, id: string): T {
  const value = map.get(id);
  if (value === undefined) throw new Error(`no content for page "${id}"`);
  return value;
}

// "See my work" opens the first work page in deck order (the internship comes first).
const firstWork = groups.find((g) => g.id === 'internship' || g.id === 'projects');
const workHref = `#${firstWork?.firstPageId ?? 'about'}`;

// The same facts as the page, as schema.org data for search engines and AI screening tools.
const uni = education[0];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  description: profile.headline,
  sameAs: [profile.linkedin, ...(profile.github ? [profile.github] : [])],
  knowsAbout: [...(profile.focus ?? []), ...(profile.languages ?? [])],
  ...(uni ? { affiliation: { '@type': 'CollegeOrUniversity', name: uni.institution } } : {}),
};
---

<Base
  title={`${profile.name}: data science and AI portfolio`}
  description={profile.headline}
  jsonLd={jsonLd}
>
  <Deck>
    {pages.map((page) => {
      switch (page.group) {
        case 'home':
          return <HeroSlide page={page} workHref={workHref} />;
        case 'about':
          return <AboutSlide page={page} />;
        case 'projects':
        case 'internship':
          return <ProjectSlide page={page} project={must(projectById, page.id)} />;
        case 'achievements':
          return <AchievementSlide page={page} entry={must(achievementById, page.id)} />;
        case 'contact':
          return <ContactSlide page={page} />;
      }
    })}
  </Deck>
  <Taskbar groups={groups} />
</Base>
