---
// Case-study page (plan section 6): summary and status, role, the narrative, results,
// limitations (always shown), then next steps.
import { render } from 'astro:content';
import ResultsTable from '../../components/ResultsTable.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Page from '../../layouts/Page.astro';
import { profile, visibleProjects } from '../../lib/data.ts';
import { formatPeriod, KIND_LABEL, projectLinks, shortTitle } from '../../lib/format.ts';
import Window from '../../components/Window.astro';

export async function getStaticPaths() {
  const projects = await visibleProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const resultsWithheld = !d.results && d.status === 'being-improved';
const links = projectLinks(d.links);
---

<Page title={`${d.title}: ${profile.name}`} description={d.summary}>
  <p class="crumb">
    <a href="/projects/">All projects</a>
  </p>
  <Window title={shortTitle(d.title)} class="case-head">
    {d.organisation?.logo && (
      <p class="org-logo">
        <img
          src={d.organisation.logo.src}
          alt={d.organisation.logo.alt}
          width={d.organisation.logo.width}
          height={d.organisation.logo.height}
          decoding="async"
        />
      </p>
    )}
    <h1>{d.title}</h1>
    <p class="meta">
      <StatusBadge status={d.status} />
      <span>
        {KIND_LABEL[d.kind]}
        {d.organisation && ` at ${d.organisation.name}`},{' '}
        {formatPeriod(d.kind, d.period.start, d.period.end)}
      </span>
    </p>
    <p class="summary">{d.summary}</p>
    {(d.skills ?? d.stack).length > 0 && (
      <ul class="chips" aria-label="Skills and tools">
        {[...(d.skills ?? []), ...d.stack].map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    )}
    {links.length > 0 && (
      <p class="links">
        {links.map((l) => (
          <a class="pixel-button pixel-button--quiet" href={l.href}>
            {l.label}
          </a>
        ))}
      </p>
    )}
  </Window>

  <h2>My role</h2>
  <p>{d.role}</p>

  <Content />

  {d.results && (
    <>
      <h2>Results</h2>
      <ResultsTable results={d.results} />
    </>
  )}
  {resultsWithheld && (
    <section class="withheld" aria-labelledby="withheld-title">
      <h2 id="withheld-title">Results withheld while the evaluation is redone</h2>
      {d.nextSteps && (
        <>
          <p>The next version adds:</p>
          <ol>
            {d.nextSteps.map((s) => (
              <li>{s}</li>
            ))}
          </ol>
        </>
      )}
    </section>
  )}

  <h2 id="limitations">Limitations</h2>
  <ul>
    {d.limitations.map((l) => (
      <li>{l}</li>
    ))}
  </ul>

  {d.nextSteps && !resultsWithheld && (
    <>
      <h2>Next steps</h2>
      <ul>
        {d.nextSteps.map((s) => (
          <li>{s}</li>
        ))}
      </ul>
    </>
  )}

  <p class="stack">
    <strong>Stack:</strong> {d.stack.join(', ')}
  </p>
</Page>

<style>
  .crumb {
    margin: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }
  .summary {
    margin-bottom: 0;
    font-size: 1.125rem;
  }
  /* A light plate, so a logo drawn for a white page stays legible on the dark theme. */
  .org-logo {
    display: inline-block;
    margin: 0 0 var(--space-3);
    padding: var(--space-1);
    background: var(--color-accent-2);
  }
  .org-logo img {
    display: block;
    width: auto;
    height: 4.5rem;
  }
  :global(.case-head) {
    margin: var(--space-3) 0 var(--space-5);
  }
  :global(.case-head h1) {
    margin-top: 0;
  }
  .withheld {
    margin-top: var(--space-5);
    padding: var(--space-4);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 2px var(--color-warning);
  }
  .withheld h2 {
    margin-top: 0;
  }
  .stack {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
  }
  /* Skills from the project, then its tools: the same white chips as the deck page. */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    margin: 0;
    padding: 0.25em 0.7em;
    font-size: 0.9375rem;
    font-weight: 700;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 2px var(--color-accent-2);
  }
</style>
