---
// Slide 3: up to three featured projects (plan section 3).
import { visibleProjects } from '../lib/data.ts';
import ProjectCard from './ProjectCard.astro';
import Window from './Window.astro';

const projects = await visibleProjects();
const featured = projects.filter((p) => p.data.featured);
---

<section id="work" class="slide" data-slide aria-labelledby="work-title">
  <Window title="Work" heading={{ level: 2, id: 'work-title' }}>
    <div class="work__cards">
      {featured.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
    <p class="work__all">
      <a href="/projects/">See all {projects.length} projects</a>
    </p>
  </Window>
</section>

<style>
  .work__cards {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .work__cards {
      grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    }
  }
  .work__all {
    margin-top: var(--space-5);
  }
</style>
