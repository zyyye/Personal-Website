---
// Slide 3: up to three featured projects (plan section 3).
import { visibleProjects } from '../lib/data.ts';
import ProjectCard from './ProjectCard.astro';

const projects = await visibleProjects();
const featured = projects.filter((p) => p.data.featured);
---

<section id="work" class="slide" data-slide aria-labelledby="work-title">
  <div class="window work">
    <h2 id="work-title">Work</h2>
    <div class="work__cards">
      {featured.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
    <p class="work__all">
      <a href="/projects/">All projects ({projects.length})</a>
    </p>
  </div>
</section>

<style>
  .work {
    width: min(100%, 72rem);
  }
  .work__cards {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 48rem) {
    .work__cards {
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    }
  }
  .work__all {
    margin-top: var(--space-3);
  }
</style>
