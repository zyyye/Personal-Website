---
// One project or internship page in the deck.
// Left: the title block (with the employer's logo when there is one), summary, role, chosen skills
// (deckSkills) and stack, and
// the case-study link. Right: the highlighted results, drawn as one bar chart per metric, or as one
// grouped chart that compares the same series on several metrics (resultsChart: grouped), with a
// link to the caveats; or the project's flow (how it works, step by step); or the "results
// withheld" note. Highlight tiles run along the bottom.
import type { CollectionEntry } from 'astro:content';
import { capitalise, formatPeriod, KIND_LABEL, projectLinks, shortTitle } from '../lib/format.ts';
import { leadingNumber, type DeckPage } from '../lib/pages.ts';
import Slide from './Slide.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  page: DeckPage;
  project: CollectionEntry<'projects'>;
}
const { page, project } = Astro.props;
const d = project.data;
const titleId = `${project.id}-title`;
const logo = d.organisation?.logo;
const links = projectLinks(d.links);

const highlighted = (d.results ?? []).filter((r) => r.highlight);
const widthOf = (value: string) => `${((leadingNumber(value) ?? 0) * 100).toFixed(1)}%`;

// 'bars': one chart per metric, in the order the metrics first appear, so the bars in a chart
// compare. The content check caps the number of metrics and keeps every value between 0 and 1.
const grouped = d.resultsChart === 'grouped';
const charts = grouped
  ? []
  : [...new Set(highlighted.map((r) => r.metric))].map((metric) => {
      const rows = highlighted.filter((r) => r.metric === metric);
      return {
        caption: `${capitalise(metric)}, ${rows[0]?.n ?? ''}`,
        bars: rows.map((r) => ({
          label: r.seeds && r.seeds > 1 ? `${r.label} (${r.seeds} seeds)` : r.label,
          value: r.value,
          width: widthOf(r.value),
        })),
      };
    });

// 'grouped': series are the row labels; groups are metrics, under a heading per level. The content
// check guarantees one row per series in every group.
const series = grouped ? [...new Set(highlighted.map((r) => r.label))] : [];
const levels = grouped
  ? [...new Set(highlighted.map((r) => r.level ?? ''))].map((level) => {
      const rows = highlighted.filter((r) => (r.level ?? '') === level);
      const n = rows[0]?.n ?? '';
      return {
        heading: level ? `${capitalise(level)}, ${n}` : n,
        groups: [...new Set(rows.map((r) => r.metric))].map((metric) => ({
          metric: capitalise(metric),
          bars: series.map((s, index) => {
            const value = rows.find((r) => r.metric === metric && r.label === s)?.value ?? '';
            return { series: s, index, value, width: widthOf(value) };
          }),
        })),
      };
    })
  : [];

const hasChart = charts.length > 0 || levels.length > 0;
const withheld = !d.results && d.status === 'being-improved';
---

<Slide page={page} labelledby={titleId}>
  <div class="project">
    <div class="project__text">
      <div
        class:list={['project__head', logo && 'project__head--logo']}
        data-fit-height={logo ? '' : undefined}
      >
        {logo && (
          <p class="org-logo">
            <img
              src={logo.src}
              alt={logo.alt}
              width={logo.width}
              height={logo.height}
              decoding="async"
            />
          </p>
        )}
        <div class="project__titles" data-fit-height-text>
          <h2 id={titleId} class="page-title">
            {shortTitle(d.title)}
          </h2>
          <p class="project__meta">
            <StatusBadge status={d.status} />
            <span>
              {KIND_LABEL[d.kind]}
              {d.organisation && ` at ${d.organisation.name}`},{' '}
              {formatPeriod(d.kind, d.period.start, d.period.end)}
            </span>
          </p>
        </div>
      </div>
      <p class="project__summary">{d.summary}</p>
      <h3>My role</h3>
      <p>{d.role}</p>
      <ul class="tags" aria-label="Skills and tools">
        {[...(d.deckSkills ?? []), ...d.stack].map((s) => (
          <li>{s}</li>
        ))}
      </ul>
      <p class="project__more">
        <a class="pixel-button" href={`/projects/${project.id}/`}>
          Read the case study
        </a>
        {links.map((l) => (
          <a class="pixel-button pixel-button--quiet" href={l.href}>
            {l.label}
          </a>
        ))}
      </p>
    </div>

    <div class="project__side">
      {charts.map((c) => (
        <figure class="bars">
          <figcaption>{c.caption}</figcaption>
          <ul>
            {c.bars.map((b) => (
              <li>
                <span class="bars__label">{b.label}</span>
                <span class="bars__value">{b.value}</span>
                <span class="bars__track" aria-hidden="true">
                  <span class="bars__fill" style={`width: ${b.width}`} />
                </span>
              </li>
            ))}
          </ul>
        </figure>
      ))}
      {levels.length > 0 && (
        <figure class="gchart" style={`--series: ${series.length}`}>
          <figcaption class="gchart__legend">
            {series.map((s, i) => (
              <span class="gchart__key">
                <span class={`gchart__swatch gchart__swatch--${i}`} aria-hidden="true" />
                {s}
              </span>
            ))}
          </figcaption>
          {levels.map((l) => (
            <div class="gchart__level">
              <p class="gchart__heading">{l.heading}</p>
              <ul>
                {l.groups.map((g) => (
                  <li class="gchart__group">
                    <span class="gchart__metric">{g.metric}</span>
                    {g.bars.map((b) => (
                      <span class="gchart__bar">
                        <span class="gchart__track" aria-hidden="true">
                          <span
                            class={`gchart__fill gchart__fill--${b.index}`}
                            style={`width: ${b.width}`}
                          />
                        </span>
                        <span class="gchart__value">
                          <span class="visually-hidden">{b.series}: </span>
                          {b.value}
                        </span>
                      </span>
                    ))}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </figure>
      )}
      {hasChart && d.limitations.length > 0 && (
        <p class="caveats">
          <a href={`/projects/${project.id}/#limitations`}>Caveats and limitations</a>
        </p>
      )}
      {d.flow && (
        <figure class="flow">
          <figcaption>{d.flow.caption}</figcaption>
          <ol>
            {d.flow.steps.map((s) => (
              <li>
                <span class="flow__title">{s.title}</span>
                <span class="flow__detail">{s.detail}</span>
              </li>
            ))}
          </ol>
        </figure>
      )}
      {withheld && (
        <p class="withheld">
          Results are withheld while the evaluation is redone.{' '}
          <a href={`/projects/${project.id}/`}>See what the next version adds</a>
        </p>
      )}
    </div>

    {d.highlights && (
      <ol class="tiles">
        {d.highlights.map((h) => (
          <li>
            <span class="tiles__title">{h.title}</span>
            <span class="tiles__detail">{h.detail}</span>
          </li>
        ))}
      </ol>
    )}
  </div>
</Slide>

<style>
  .project {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 1fr) 30rem;
      gap: var(--space-4) 4rem;
    }
  }

  /* With a logo, the logo is a square as tall as the title block beside it: it starts at the title
     and ends with the meta line (Leo, 21 Nov 2026). src/scripts/fit-height.ts sets --fit-height from
     the block's height; the default fits a three-line block. On narrow screens it is capped. */
  .project__head--logo {
    /* The title's letters start 0.31em below its line box (Silkscreen at line-height 1.1,
       measured), so the logo starts there too. */
    --title-inset: calc(0.31 * var(--page-title-size));
    --logo-box: min(calc(var(--fit-height, 8rem) - var(--title-inset)), 30vw);
    display: grid;
    grid-template-columns: var(--logo-box) minmax(0, 1fr);
    column-gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-3);
  }
  .project__head--logo .project__meta {
    margin-bottom: 0;
  }
  .org-logo {
    box-sizing: border-box;
    width: var(--logo-box);
    height: var(--logo-box);
    margin: var(--title-inset) 0 0;
    padding: var(--space-1);
    background: var(--color-accent-2);
    box-shadow: 0 0 0 2px var(--color-border);
  }
  .org-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .project__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }
  .project__summary {
    margin: 0 0 var(--space-3);
    font-size: 1.1875rem;
  }
  h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.125rem;
    color: var(--color-accent);
  }
  .project__text > p {
    max-width: 40rem;
  }

  /* Skill and stack chips: white frame and bold text, so they read at a glance (Leo, 21 Nov 2026).
     White, not mint: mint means clickable. */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.25em 0.7em;
    font-size: 0.9375rem;
    font-weight: 700;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 2px var(--color-accent-2);
  }
  .project__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-3) 0 0;
  }

  .project__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .caveats {
    margin: calc(-1 * var(--space-2)) 0 0;
    font-size: 0.9375rem;
  }

  .bars {
    margin: 0;
  }
  .bars figcaption {
    margin-bottom: var(--space-3);
    font-weight: 700;
  }
  .bars ul {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bars li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    font-size: 0.9375rem;
  }
  .bars__value {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .bars__track {
    grid-column: 1 / -1;
    height: 1rem;
    background: var(--color-surface);
  }
  .bars__fill {
    display: block;
    height: 100%;
    background: var(--color-accent);
  }

  /* Grouped chart: a metric label on the left spanning one bar per series. Series colours: grey,
     then mint (the result being shown off), then white. */
  .gchart {
    margin: 0;
    font-size: 0.9375rem;
  }
  .gchart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-bottom: var(--space-3);
    font-weight: 700;
  }
  .gchart__key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .gchart__swatch {
    width: 0.875rem;
    height: 0.875rem;
  }
  .gchart__level + .gchart__level {
    margin-top: var(--space-3);
  }
  .gchart__heading {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }
  .gchart ul {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gchart__group {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr) 2.75rem;
    align-items: center;
    gap: 3px var(--space-3);
  }
  .gchart__metric {
    grid-row: span var(--series);
    font-weight: 700;
  }
  .gchart__bar {
    display: contents;
  }
  .gchart__track {
    height: 0.75rem;
    background: var(--color-surface);
  }
  .gchart__fill {
    display: block;
    height: 100%;
  }
  .gchart__value {
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    text-align: right;
  }
  .gchart__swatch--0,
  .gchart__fill--0 {
    background: var(--color-text-muted);
  }
  .gchart__swatch--1,
  .gchart__fill--1 {
    background: var(--color-accent);
  }
  .gchart__swatch--2,
  .gchart__fill--2 {
    background: var(--color-accent-2);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tiles li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 2px var(--color-border);
  }
  @media (min-width: 64rem) {
    /* The highlight tiles run in one row along the bottom (Leo, 21 Nov 2026). */
    .tiles {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tiles__title {
    font-weight: 700;
  }
  .tiles__detail {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  /* A project's flow: numbered steps joined by a short line, white structure (not mint). */
  .flow {
    margin: 0;
  }
  .flow figcaption {
    margin-bottom: var(--space-3);
    font-weight: 700;
  }
  .flow ol {
    --flow-gap: var(--space-2);
    display: grid;
    gap: var(--flow-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .flow li {
    position: relative;
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    box-shadow: inset 0 0 0 2px var(--color-border);
    counter-increment: step;
  }
  .flow li::before {
    content: counter(step);
    grid-row: span 2;
    align-self: center;
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-accent-2);
  }
  .flow li + li::after {
    content: '';
    position: absolute;
    bottom: 100%;
    left: calc(var(--space-3) + 0.75rem - 1px);
    width: 2px;
    height: var(--flow-gap);
    background: var(--color-accent-2);
  }
  .flow__title {
    font-weight: 700;
  }
  .flow__detail {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .withheld {
    margin: var(--space-4) 0 0;
    padding: var(--space-3);
    box-shadow: inset 0 0 0 2px var(--color-accent-2);
  }
</style>
