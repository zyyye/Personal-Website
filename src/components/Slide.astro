---
// One page of the home deck. The data attributes are what src/scripts/deck.ts reads to mark the
// current tab and show "2 of 3", so every page is wrapped by this one component.
import { GROUP_LABEL, type DeckPage } from '../lib/pages.ts';

interface Props {
  page: DeckPage;
  /** id of the element that names this page (its heading). */
  labelledby: string;
}
const { page, labelledby } = Astro.props;
---

<section
  id={page.id}
  class="slide"
  data-slide
  data-group={page.group}
  data-title={page.title}
  data-position={page.position}
  data-group-size={page.groupSize}
  aria-labelledby={labelledby}
>
  <div class="slide__inner">
    {page.groupSize > 1 && (
      <p class="slide__position">
        {GROUP_LABEL[page.group]} {page.position} of {page.groupSize}
      </p>
    )}
    <slot />
  </div>
</section>

<style>
  .slide__position {
    margin: 0 0 var(--space-3);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
</style>
