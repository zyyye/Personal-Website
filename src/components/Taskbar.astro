---
// Bottom taskbar, "pixel keys" design (chosen by Leo from the design lab, 19 Nov 2026).
// - 'deck' (home page): one key per group, jumping to the group's first page; keys for the page
//   above and below; the manual "Deck" switch (plan section 3B, rule 4).
// - 'page' (project pages): simple top-level navigation, with the CV only when it is ready.
// Links are real anchors, so navigation works without JavaScript; the step keys and the Deck
// switch need the script and are hidden without it.
import { CONTROL_ICONS, GROUP_ICONS } from '../data/sprites.ts';
import { profile } from '../lib/data.ts';
import type { DeckGroup } from '../lib/pages.ts';
import PixelIcon from './PixelIcon.astro';
import Sprite from './Sprite.astro';

interface Props {
  variant?: 'deck' | 'page';
  /** For 'deck': one key per group. */
  groups?: DeckGroup[];
  /** For 'page': the href of the current page, marked with aria-current. */
  current?: string;
}
const { variant = 'deck', groups = [], current } = Astro.props;

// Groups that collect items show how many pages they hold, e.g. "Projects (3)" (Leo, 21 Nov 2026).
// Home, About and Contact are single fixed pages, so a count would add nothing.
const COUNTED_GROUPS = new Set<DeckGroup['id']>(['internship', 'projects', 'achievements']);

const pageLinks = [
  { href: '/', label: 'Home', icon: GROUP_ICONS.home },
  { href: '/projects/', label: 'Projects', icon: GROUP_ICONS.projects },
  ...(profile.cv.ready ? [{ href: profile.cv.path, label: 'CV', icon: GROUP_ICONS.about }] : []),
];
---

<nav class="taskbar" aria-label={variant === 'deck' ? 'Pages' : 'Site'}>
  <span class="taskbar__mascot">
    <Sprite size={32} />
  </span>
  <ul class="taskbar__keys">
    {variant === 'deck'
      ? groups.map((g) => (
          <li>
            <a class="key" href={`#${g.firstPageId}`} data-slide-link data-group-link={g.id}>
              <PixelIcon grid={GROUP_ICONS[g.id]} />
              <span class="key__label">
                {g.label}
                {COUNTED_GROUPS.has(g.id) && <span class="key__count"> ({g.size})</span>}
              </span>
            </a>
          </li>
        ))
      : pageLinks.map((l) => (
          <li>
            <a class="key" href={l.href} aria-current={l.href === current ? 'page' : undefined}>
              <PixelIcon grid={l.icon} />
              <span class="key__label">{l.label}</span>
            </a>
          </li>
        ))}
  </ul>
  {variant === 'deck' && (
    <div class="taskbar__controls" data-needs-script>
      <button type="button" class="key" data-step="-1" aria-label="Previous page">
        <PixelIcon grid={CONTROL_ICONS.up} />
      </button>
      <button type="button" class="key" data-step="1" aria-label="Next page">
        <PixelIcon grid={CONTROL_ICONS.down} />
      </button>
      <button type="button" class="key key--mode" data-mode-toggle aria-pressed="false">
        <PixelIcon grid={CONTROL_ICONS.slides} />
        <span class="key__label">Deck</span>
        <span class="key__state" data-mode-state aria-hidden="true">
          Off
        </span>
      </button>
    </div>
  )}
</nav>

<style>
  .taskbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--taskbar-h);
    padding: var(--space-2) var(--space-2) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
    background: var(--color-surface);
    box-shadow: 0 calc(-1 * var(--px)) 0 0 var(--color-border);
  }
  .taskbar__mascot {
    display: flex;
    padding: var(--px);
    background: var(--color-bg);
    box-shadow: inset 0 0 0 2px var(--color-border);
  }
  .taskbar__keys,
  .taskbar__controls {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .taskbar__keys {
    flex: 1;
    min-width: 0;
  }

  /* A key: raised by a 4px edge; the current page's key is pressed in (plan section 3A). */
  .key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 2.25rem;
    min-height: 2.75rem;
    margin-bottom: var(--px);
    padding: 0 clamp(0rem, 1.1vw, 0.875rem);
    font: inherit;
    font-family: var(--font-display);
    font-size: 0.875rem;
    line-height: 1;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
    background: var(--color-key);
    border: 0;
    box-shadow:
      inset 0 0 0 2px var(--color-border),
      0 var(--px) 0 0 var(--color-border);
    cursor: pointer;
  }
  .key:hover {
    color: var(--color-accent);
  }
  .key:active,
  .key[aria-current] {
    transform: translateY(var(--px));
    box-shadow: inset 0 0 0 2px var(--color-border);
  }
  .key[aria-current] {
    color: var(--color-accent);
    box-shadow: inset 0 0 0 3px var(--color-accent);
  }
  .key:disabled,
  .key[aria-disabled='true'] {
    color: #6b6b6b;
    cursor: not-allowed;
  }
  .key__state,
  .key__count {
    color: var(--color-text-muted);
  }
  .key[aria-current] .key__count {
    color: var(--color-accent);
  }
  .key--mode[aria-pressed='true'] .key__state {
    color: var(--color-accent);
  }

  /* Narrow screens: icons only (names stay for assistive technology), then no mascot. */
  @media (max-width: 56rem) {
    .key__label,
    .key__state {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
  @media (max-width: 30rem) {
    .taskbar,
    .taskbar__keys,
    .taskbar__controls {
      gap: 2px;
    }
    .taskbar__mascot {
      display: none;
    }
  }

  /* Without JavaScript the step keys and the Deck switch do nothing, so hide them. */
  :global(html:not([data-scroll])) [data-needs-script] {
    display: none;
  }
</style>
