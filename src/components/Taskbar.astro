---
// Bottom taskbar (plan sections 3 and 3B).
// - 'deck' (home page): direct jumps to each slide, plus the manual "Deck / Plain scroll" switch.
// - 'page' (project pages): simple top-level navigation, with the CV only when it is ready.
// Links are real anchors, so they work without JavaScript.
import { profile } from '../lib/data.ts';
import { SLIDES } from '../lib/slides.ts';

interface Props {
  variant?: 'deck' | 'page';
  /** For 'page': the href of the current page, marked with aria-current. */
  current?: string;
}
const { variant = 'deck', current } = Astro.props;

const pageLinks = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/projects/', label: 'Projects' },
  ...(profile.cv.ready ? [{ href: profile.cv.path, label: 'CV' }] : []),
];
---

<nav class="taskbar" aria-label={variant === 'deck' ? 'Slides' : 'Site'}>
  <ul class="taskbar__links">
    {variant === 'deck'
      ? SLIDES.map((s) => (
          <li>
            <a href={`#${s.id}`} data-slide-link>
              {s.label}
            </a>
          </li>
        ))
      : pageLinks.map((l) => (
          <li>
            <a href={l.href} aria-current={l.href === current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))}
  </ul>
  {variant === 'deck' && (
    <button type="button" class="taskbar__mode" data-mode-toggle aria-pressed="false">
      Deck{' '}
      <span class="taskbar__state" data-mode-state aria-hidden="true">
        Off
      </span>
    </button>
  )}
</nav>

<style>
  .taskbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--taskbar-h);
    padding: var(--space-1) var(--space-2) calc(var(--space-1) + env(safe-area-inset-bottom, 0px));
    background: var(--color-surface);
    box-shadow: 0 calc(-1 * var(--px)) 0 0 var(--color-border);
    /* Fluid sizes so all five links and the switch fit a 360px screen (plan section 3B, rule 2). */
    font-size: clamp(0.8125rem, 3.4vw, 1rem);
  }

  .taskbar__links {
    display: flex;
    flex: 1;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
  }

  .taskbar__links a {
    display: block;
    padding: var(--space-2) clamp(0.3rem, 1.4vw, 0.75rem);
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .taskbar__links a:hover {
    color: var(--color-accent);
  }

  .taskbar__links a[aria-current='true'],
  .taskbar__links a[aria-current='page'] {
    color: var(--color-accent);
    box-shadow: inset 0 calc(-1 * var(--px)) 0 0 var(--color-accent);
  }

  .taskbar__mode {
    flex: none;
    padding: var(--space-2) clamp(0.4rem, 1.4vw, 0.75rem);
    font: inherit;
    font-weight: 700;
    color: var(--color-text);
    background: var(--color-bg);
    border: 0;
    box-shadow: inset 0 0 0 2px var(--color-border);
    cursor: pointer;
  }

  .taskbar__mode[aria-pressed='true'] .taskbar__state {
    color: var(--color-accent);
  }

  .taskbar__mode[aria-disabled='true'] {
    cursor: not-allowed;
    color: var(--color-text-muted);
  }

  .taskbar__state {
    color: var(--color-text-muted);
  }

  /* Without JavaScript the switch does nothing, so hide it. */
  :global(html:not([data-scroll])) .taskbar__mode {
    display: none;
  }
</style>
