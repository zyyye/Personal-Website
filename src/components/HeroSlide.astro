---
// Slide 1 (plan section 3). Phase 4 replaces the plain name with pixel lettering and adds the mascot.
import { profile } from '../lib/data.ts';
import AvailabilityList from './AvailabilityList.astro';
---

<section id="hero" class="slide" data-slide aria-labelledby="hero-title">
  <div class="window hero">
    <p class="hero__greeting">{profile.greeting}</p>
    <h1 id="hero-title" class="hero__name">
      {profile.name}
    </h1>
    <p class="hero__headline">{profile.headline}</p>
    <div class="hero__availability">
      <p class="hero__label">Open to internships</p>
      <AvailabilityList />
    </div>
    <p class="hero__links">
      <a href={profile.linkedin} rel="me noopener">
        LinkedIn
      </a>
      <a href="#about" class="hero__enter">
        Enter <span aria-hidden="true">↓</span>
      </a>
    </p>
  </div>
</section>

<style>
  .hero__greeting {
    margin: 0;
    color: var(--color-accent-2);
    font-family: var(--font-display);
  }
  .hero__name {
    margin: 0.1em 0 0.3em;
    font-family: var(--font-display);
    font-size: clamp(2rem, 8vw, 4rem);
    line-height: 1.1;
  }
  .hero__headline {
    max-width: 38rem;
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
  }
  .hero__label {
    margin: 0 0 var(--space-1);
    color: var(--color-text-muted);
  }
  .hero__links {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }
</style>
