---
// Slide 1 (plan section 3). The name is the one bold element on the site.
// Phase 4 replaces it with assembled pixel lettering and adds the mascot beside it.
import { profile } from '../lib/data.ts';
import { formatAvailability } from '../lib/format.ts';
import Window from './Window.astro';
---

<section id="hero" class="slide" data-slide aria-labelledby="hero-title">
  <Window title="Home" class="hero">
    <p class="hero__greeting">{profile.greeting}</p>
    <h1 id="hero-title" class="hero__name">
      {profile.name}
    </h1>
    <p class="hero__headline">{profile.headline}</p>
    <div class="hero__open">
      <p class="hero__open-label">Open to internships</p>
      <ul class="pixel-list">
        {profile.availability.map((a) => (
          <li>{formatAvailability(a)}</li>
        ))}
      </ul>
    </div>
    <p class="hero__actions">
      <a class="pixel-button" href="#about">
        Enter
      </a>
      <a class="pixel-button pixel-button--quiet" href={profile.linkedin} rel="me">
        LinkedIn
      </a>
    </p>
  </Window>
</section>

<style>
  .hero__greeting {
    margin: 0 0 var(--space-2);
    font-size: 1.25rem;
    color: var(--color-text-muted);
  }
  .hero__name {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 400;
    /* Whole multiples of the face's 8px grid keep the pixels crisp. */
    font-size: 32px;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-text);
    text-shadow:
      3px 3px 0 var(--color-accent-2-deep),
      6px 6px 0 var(--color-shadow);
  }
  @media (min-width: 30rem) {
    .hero__name {
      font-size: 56px;
      text-shadow:
        4px 4px 0 var(--color-accent-2-deep),
        8px 8px 0 var(--color-shadow);
    }
  }
  @media (min-width: 64rem) {
    .hero__name {
      font-size: 96px;
      text-shadow:
        6px 6px 0 var(--color-accent-2-deep),
        12px 12px 0 var(--color-shadow);
    }
  }
  .hero__headline {
    max-width: 34rem;
    margin: 0 0 var(--space-4);
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
  }
  .hero__open-label {
    margin: 0 0 var(--space-2);
    font-weight: 700;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 0;
  }
</style>
