---
import type { CollectionEntry } from 'astro:content';
import { formatRange, KIND_LABEL, shortTitle } from '../lib/format.ts';
import StatusBadge from './StatusBadge.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  headingLevel?: 'h3' | 'h2';
}
const { project, headingLevel = 'h3' } = Astro.props;
const d = project.data;
const Heading = headingLevel;
---

<article class="card pixel-frame">
  <Heading class="card__title">
    <a href={`/projects/${project.id}/`}>{shortTitle(d.title)}</a>
  </Heading>
  <p class="card__meta">
    <StatusBadge status={d.status} />
    <span>
      {KIND_LABEL[d.kind]}, {formatRange(d.period.start, d.period.end)}
    </span>
  </p>
  <p class="card__summary">{d.summary}</p>
  <ul class="card__tags" aria-label="Stack">
    {d.stack.slice(0, 4).map((s) => (
      <li>{s}</li>
    ))}
  </ul>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: var(--px);
    padding: var(--space-4);
    background: var(--color-bg);
  }
  .card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
  }
  .card__title a {
    text-decoration: none;
  }
  .card__title a:hover {
    text-decoration: underline;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .card__summary {
    margin: 0;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .card__tags li {
    padding: 0.1em 0.5em;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    background: var(--color-surface);
  }
</style>
