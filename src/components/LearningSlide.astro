---
// Slide 4: skills grouped by the project that shows them (plan section 8.6), then certificates
// and courses, in-progress first.
import { learningEntries, visibleProjects } from '../lib/data.ts';
import { formatMonth, shortTitle } from '../lib/format.ts';

const projects = await visibleProjects();
const learning = await learningEntries();
---

<section id="learning" class="slide" data-slide aria-labelledby="learning-title">
  <div class="window learning">
    <h2 id="learning-title">Skills and learning</h2>
    <div class="learning__cols">
      <section aria-labelledby="skills-title">
        <h3 id="skills-title">Skills, by where I used them</h3>
        <dl class="skills">
          {projects.map((p) => (
            <div>
              <dt>
                <a href={`/projects/${p.id}/`}>{shortTitle(p.data.title)}</a>
              </dt>
              <dd>{p.data.stack.join(', ')}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section aria-labelledby="certs-title">
        <h3 id="certs-title">Certificates and courses</h3>
        <ul class="certs">
          {learning.map((l) => (
            <li>
              <span>{l.data.title}</span>
              <span class="certs__meta">
                {l.data.provider},{' '}
                {l.data.status === 'in-progress'
                  ? 'in progress'
                  : l.data.date
                    ? formatMonth(l.data.date)
                    : 'completed'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  .learning {
    width: min(100%, 72rem);
  }
  .learning__cols {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 48rem) {
    .learning__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-2);
    font-size: 1rem;
    font-family: var(--font-display);
  }
  .skills {
    margin: 0;
  }
  .skills div + div {
    margin-top: var(--space-2);
  }
  .skills dd {
    margin: 0;
  }
  .certs {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .certs li {
    display: flex;
    flex-direction: column;
  }
  .certs li + li {
    margin-top: var(--space-2);
  }
  .certs__meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
