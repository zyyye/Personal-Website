---
// Slide 4: skills grouped by the project that shows them (plan section 8.6), then certificates
// and courses, in-progress first.
import { learningEntries, visibleProjects } from '../lib/data.ts';
import { formatMonth, shortTitle } from '../lib/format.ts';
import Window from './Window.astro';

const projects = await visibleProjects();
const learning = await learningEntries();
---

<section id="learning" class="slide" data-slide aria-labelledby="learning-title">
  <Window title="Skills and learning" heading={{ level: 2, id: 'learning-title' }}>
    <div class="learning__cols">
      <section aria-labelledby="skills-title">
        <h3 id="skills-title">Skills, by where I used them</h3>
        <div class="skills">
          {projects.map((p) => (
            <div class="skills__group">
              <a class="skills__project" href={`/projects/${p.id}/`}>
                {shortTitle(p.data.title)}
              </a>
              <ul class="tags">
                {p.data.stack.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      <section aria-labelledby="certs-title">
        <h3 id="certs-title">Certificates and courses</h3>
        <ul class="certs pixel-list">
          {learning.map((l) => (
            <li>
              <span class="certs__title">{l.data.title}</span>
              <span class="certs__meta">
                {l.data.provider},{' '}
                {l.data.status === 'in-progress'
                  ? 'in progress'
                  : l.data.date
                    ? formatMonth(l.data.date)
                    : 'completed'}
              </span>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </Window>
</section>

<style>
  .learning__cols {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 48rem) {
    .learning__cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    margin: 0 0 var(--space-3);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-accent-2);
  }
  .skills__group + .skills__group {
    margin-top: var(--space-4);
  }
  .skills__project {
    font-weight: 700;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.15em 0.6em;
    font-size: 0.875rem;
    background: var(--color-bg);
    box-shadow: inset 0 0 0 2px var(--color-border);
  }
  .certs__title {
    display: block;
  }
  .certs__meta {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
