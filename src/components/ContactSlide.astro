---
// Slide 5. GitHub and the CV appear only when ready (plan section 3, "Links and photo").
import { profile } from '../lib/data.ts';
---

<section id="contact" class="slide" data-slide aria-labelledby="contact-title">
  <div class="window contact">
    <h2 id="contact-title">Contact</h2>
    <dl class="contact__list">
      <div>
        <dt>Email</dt>
        <dd>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </dd>
      </div>
      <div>
        <dt>LinkedIn</dt>
        <dd>
          <a href={profile.linkedin} rel="me noopener">
            {profile.linkedin.replace('https://www.', '')}
          </a>
        </dd>
      </div>
      {profile.github && (
        <div>
          <dt>GitHub</dt>
          <dd>
            <a href={profile.github} rel="me noopener">
              {profile.github.replace('https://', '')}
            </a>
          </dd>
        </div>
      )}
      {profile.cv.ready && (
        <div>
          <dt>CV</dt>
          <dd>
            <a href={profile.cv.path}>Download my CV (PDF)</a>
          </dd>
        </div>
      )}
      <div>
        <dt>Location</dt>
        <dd>{profile.location}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contact {
    width: min(100%, 40rem);
  }
  .contact__list {
    margin: 0;
  }
  .contact__list div + div {
    margin-top: var(--space-3);
  }
  dt {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
