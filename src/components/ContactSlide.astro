---
// Slide 5. GitHub and the CV appear only when ready (plan section 3, "Links and photo").
import { profile } from '../lib/data.ts';
import Window from './Window.astro';
---

<section id="contact" class="slide" data-slide aria-labelledby="contact-title">
  <Window title="Contact" heading={{ level: 2, id: 'contact-title' }} class="contact">
    <p class="contact__lead">The quickest way to reach me is email.</p>
    <p class="contact__email">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
    <ul class="contact__links pixel-list">
      <li>
        <a href={profile.linkedin} rel="me">
          LinkedIn
        </a>
      </li>
      {profile.github && (
        <li>
          <a href={profile.github} rel="me">
            GitHub
          </a>
        </li>
      )}
      {profile.cv.ready && (
        <li>
          <a href={profile.cv.path}>CV (PDF)</a>
        </li>
      )}
    </ul>
    <p class="contact__where">{profile.location}</p>
  </Window>
</section>

<style>
  .contact {
    width: min(100%, 44rem);
  }
  .contact__lead {
    margin: 0 0 var(--space-2);
    color: var(--color-text-muted);
  }
  .contact__email {
    margin: 0 0 var(--space-5);
    font-weight: 700;
    font-size: clamp(1.25rem, 5vw, 2.25rem);
    overflow-wrap: anywhere;
  }
  .contact__links {
    margin-bottom: var(--space-5);
  }
  .contact__where {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
</style>
