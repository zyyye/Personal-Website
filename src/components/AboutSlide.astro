---
// Slide 2 (plan section 8.7): ID badge, then "What I'm good at", "Where I'm headed", "How I got here".
import { education, learningEntries, profile, resolveTargets } from '../lib/data.ts';
import { formatMonth } from '../lib/format.ts';
import AvailabilityList from './AvailabilityList.astro';

const target = await resolveTargets();
const { about, targetRoles, photo } = profile;
const learningNow = (await learningEntries()).filter((l) => l.data.status === 'in-progress');

const uni = education[0];
if (!uni) throw new Error('education.json needs at least one entry');
const captionParts = [
  `${uni.credential}, ${uni.shortName ?? uni.institution}`,
  uni.minor ? `Minor in ${uni.minor}` : undefined,
  uni.gpa && uni.gpaAsOf ? `GPA ${uni.gpa} (as of ${formatMonth(uni.gpaAsOf)})` : undefined,
].filter(Boolean);
---

<section id="about" class="slide" data-slide aria-labelledby="about-title">
  <div class="window about">
    <h2 id="about-title">About</h2>
    <div class="about__layout">
      <figure class="badge">
        <img
          src={photo.src}
          alt={photo.alt}
          width="400"
          height="500"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{captionParts.join('. ')}.</figcaption>
      </figure>
      <div class="about__panels">
        <section class="panel" aria-labelledby="about-good">
          <h3 id="about-good">What I'm good at</h3>
          <ul>
            {about.talent.map((t) => {
              const e = target(t.evidence);
              return (
                <li>
                  {t.text}{' '}
                  <a class="chip" href={e.href}>
                    {e.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
        <section class="panel" aria-labelledby="about-headed">
          <h3 id="about-headed">Where I'm headed</h3>
          <p>Aiming for, in order of preference: {targetRoles.join(', ')}.</p>
          <AvailabilityList />
          {learningNow.length > 0 && (
            <p>Learning now: {learningNow.map((l) => l.data.title).join('; ')}.</p>
          )}
          {about.ambitionWhy && <p>{about.ambitionWhy}</p>}
        </section>
        <section class="panel" aria-labelledby="about-story">
          <h3 id="about-story">How I got here</h3>
          <ol class="timeline">
            {about.story.map((s) => (
              <li>
                <span class="timeline__when">{s.when}</span>
                <span>{s.ref ? <a href={target(s.ref).href}>{s.text}</a> : s.text}</span>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    width: min(100%, 72rem);
  }
  .about__layout {
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 64rem) {
    .about__layout {
      grid-template-columns: 11rem 1fr;
      align-items: start;
    }
  }
  .badge {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin: 0;
  }
  @media (min-width: 64rem) {
    .badge {
      flex-direction: column;
      align-items: stretch;
    }
  }
  .badge img {
    width: clamp(4.5rem, 20vw, 11rem);
    height: auto;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
  }
  .badge figcaption {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .about__panels {
    display: grid;
    gap: var(--space-3);
  }
  @media (min-width: 48rem) {
    .about__panels {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .panel h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-2);
    font-size: 1rem;
    font-family: var(--font-display);
  }
  .panel ul,
  .panel ol {
    margin: 0;
    padding-left: 1.2em;
  }
  .panel p {
    margin: 0 0 var(--space-2);
  }
  .panel li + li {
    margin-top: var(--space-1);
  }
  .chip {
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .timeline {
    list-style: none;
    padding-left: 0 !important;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-2);
  }
  .timeline__when {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
